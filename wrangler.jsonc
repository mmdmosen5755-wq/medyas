{
  "name": "medyas",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "MedyasContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MEDYAS", "class_name": "MedyasContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MedyasContainer"] }],
  "triggers": { "crons": ["* * * * *"] }
}
